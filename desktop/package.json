{
  "name": "course-study-utility",
  "version": "0.1.8",
  "private": true,
  "description": "兼容学习通（超星平台）的个人第三方课程辅助工具，包含任务跟踪与AI视觉识题作答，非官方产品。",
  "main": "main.js",
  "author": "local",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64",
    "verify:package": "node scripts/verify-package.cjs"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.local.chaoxing.helper",
    "productName": "课程伴学工具",
    "copyright": "个人自用",
    "asar": true,
    "electronDist": "vendor/electron/dist",
    "directories": {
      "output": "../dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "*.cjs",
      "ui/**/*",
      "userscript/**/*",
      "!**/*.log"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CourseStudyUtility-${version}-Setup-${arch}.exe",
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "课程伴学工具",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "allowElevation": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "differentialPackage": false,
      "artifactName": "CourseStudyUtility-${version}-Setup-${arch}.exe"
    },
    "executableName": "CourseStudyUtility",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "compression": "normal",
    "afterPack": "build/after-pack.cjs",
    "extraFiles": [
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "../NOTICE.md",
        "to": "NOTICE.md"
      },
      {
        "from": "../OPEN_SOURCE.md",
        "to": "OPEN_SOURCE.md"
      },
      {
        "from": "../DISCLAIMER.md",
        "to": "DISCLAIMER.md"
      }
    ]
  },
  "license": "GPL-3.0-only"
}